{
  "name": "universe-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "preview": "vite preview",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "check": "pnpm format:check && pnpm build && pnpm test"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
